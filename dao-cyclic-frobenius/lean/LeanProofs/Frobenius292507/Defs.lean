import Mathlib

/-!
# MO 292507: definitions (the statement file)

Fix `n ≥ 2` and positive integers `a₀, …, a_{n-1}`, read modulo `n`. We encode them as a function
`a : ℕ → ℕ` with `a (i + n) = a i` and `0 < a i`.

* `x n a i = 1 + aᵢ + aᵢaᵢ₊₁ + ⋯ + aᵢaᵢ₊₁⋯aᵢ₊ₙ₋₂`: the `k`-th summand is `∏_{j<k} a (i + j)`,
  `k < n`.
* `P n a = a₀a₁⋯aₙ₋₁` and `N n a = P n a - 1`.
* `InS n a m`: `m ∈ S`, the numerical semigroup generated by `x₀, …, xₙ₋₁`, i.e.
  `m = ∑_{i<n} λᵢ xᵢ` with `λᵢ ∈ ℕ`.
-/

namespace Frobenius292507

open Finset

/-- The generator `xᵢ = 1 + aᵢ + aᵢaᵢ₊₁ + ⋯ + aᵢ⋯aᵢ₊ₙ₋₂`
(`n` summands, the `k`-th one `∏_{j<k} aᵢ₊ⱼ`). -/
def x (n : ℕ) (a : ℕ → ℕ) (i : ℕ) : ℕ := ∑ k ∈ range n, ∏ j ∈ range k, a (i + j)

/-- `P = a₀a₁⋯aₙ₋₁`. -/
def P (n : ℕ) (a : ℕ → ℕ) : ℕ := ∏ j ∈ range n, a j

/-- `N = P - 1`. -/
def N (n : ℕ) (a : ℕ → ℕ) : ℕ := P n a - 1

/-- `m ∈ S = ℕx₀ + ⋯ + ℕxₙ₋₁`. -/
def InS (n : ℕ) (a : ℕ → ℕ) (m : ℕ) : Prop := ∃ c : ℕ → ℕ, ∑ i ∈ range n, c i * x n a i = m

end Frobenius292507
