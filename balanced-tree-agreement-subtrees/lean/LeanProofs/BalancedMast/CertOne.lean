/-- `r/2^K ≤ (S/N)^(2/5)`. -/
def okRoot (S r : ℕ) : Bool := decide (r ^ 5 * certN ^ 2 ≤ S ^ 2 * 2 ^ (5 * certK))

/-- Term `j` of `Φ` is at least `1` on the box. -/
def okAccept (j r₁ r₂ l₁ l₂ l₃ u₁ u₂ u₃ : ℕ) : Bool :=
  let l₄ := certN - min certN (u₁ + u₂ + u₃)
  match j with
  | 0 => okRoot l₁ r₁ && okRoot l₄ r₂ && decide (2 ^ (certK + certKQ) ≤ certQ4 * (r₁ + r₂))
  | 1 => okRoot l₂ r₁ && okRoot l₃ r₂ && decide (2 ^ (certK + certKQ) ≤ certQ4 * (r₁ + r₂))
  | 2 => okRoot (l₁ + l₂) r₁ && decide (2 ^ (certK + certKQ) ≤ certQ2 * r₁)
  | 3 => okRoot (certN - min certN (u₁ + u₂)) r₁ && decide (2 ^ (certK + certKQ) ≤ certQ2 * r₁)
  | 4 => okRoot (l₁ + l₃) r₁ && decide (2 ^ (certK + certKQ) ≤ certQ2 * r₁)
  | 5 => okRoot (certN - min certN (u₁ + u₃)) r₁ && decide (2 ^ (certK + certKQ) ≤ certQ2 * r₁)
  | _ => false

/-- Check a tree on the box `[l₁, u₁] × [l₂, u₂] × [l₃, u₃]` (in units of `1/N`). -/
def check : BT → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → Bool
  | .d, l₁, l₂, l₃, _, _, _ => decide (certN < l₁ + l₂ + l₃)
  | .a j r₁ r₂, l₁, l₂, l₃, u₁, u₂, u₃ => okAccept j r₁ r₂ l₁ l₂ l₃ u₁ u₂ u₃
  | .s lo hi, l₁, l₂, l₃, u₁, u₂, u₃ =>
    if u₂ - l₂ ≤ u₁ - l₁ ∧ u₃ - l₃ ≤ u₁ - l₁ then
      check lo l₁ l₂ l₃ ((l₁ + u₁) / 2) u₂ u₃ && check hi ((l₁ + u₁) / 2) l₂ l₃ u₁ u₂ u₃
    else if u₃ - l₃ ≤ u₂ - l₂ then
      check lo l₁ l₂ l₃ u₁ ((l₂ + u₂) / 2) u₃ && check hi l₁ ((l₂ + u₂) / 2) l₃ u₁ u₂ u₃
    else
      check lo l₁ l₂ l₃ u₁ u₂ ((l₃ + u₃) / 2) && check hi l₁ l₂ ((l₃ + u₃) / 2) u₁ u₂ u₃

/-! ## The checks, by evaluation -/

theorem certTree_ok : check certTree 0 0 0 certN certN certN = true := by decide +kernel

theorem certQ2_ok : certQ2 ^ 400 ≤ 2 ^ (33 + 400 * certKQ) := by decide +kernel

theorem certQ4_ok : certQ4 ^ 200 ≤ 2 ^ (33 + 200 * certKQ) := by decide +kernel

/-! ## Soundness -/

lemma root_le {q t : ℝ} {n : ℕ} (hn : n ≠ 0) (hq : 0 ≤ q) (h : q ^ n ≤ t) :
    q ≤ t ^ ((n : ℝ)⁻¹) := by
  have := Real.rpow_le_rpow (pow_nonneg hq n) h (by positivity : (0 : ℝ) ≤ (n : ℝ)⁻¹)
  rwa [Real.pow_rpow_inv_natCast hq hn] at this

lemma Q2_le : (certQ2 : ℝ) / 2 ^ certKQ ≤ (2 : ℝ) ^ ((33 : ℝ) / 400) := by
  have h : ((certQ2 : ℝ) / 2 ^ certKQ) ^ 400 ≤ (2 : ℝ) ^ (33 : ℕ) := by
    rw [div_pow, div_le_iff₀ (by positivity), ← pow_mul, ← pow_add]
    exact_mod_cast certQ2_ok
  have := root_le (n := 400) (by norm_num) (by positivity) h
  have e : (2 : ℝ) ^ ((33 : ℝ) / 400) = ((2 : ℝ) ^ (33 : ℕ)) ^ (((400 : ℕ) : ℝ)⁻¹) := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num)]; norm_num
  rw [e]; exact this

lemma Q4_le : (certQ4 : ℝ) / 2 ^ certKQ ≤ (4 : ℝ) ^ ((33 : ℝ) / 400) := by
  have h : ((certQ4 : ℝ) / 2 ^ certKQ) ^ 200 ≤ (2 : ℝ) ^ (33 : ℕ) := by
    rw [div_pow, div_le_iff₀ (by positivity), ← pow_mul, ← pow_add]
    exact_mod_cast certQ4_ok
  have := root_le (n := 200) (by norm_num) (by positivity) h
  have e : (4 : ℝ) ^ ((33 : ℝ) / 400) = ((2 : ℝ) ^ (33 : ℕ)) ^ (((200 : ℕ) : ℝ)⁻¹) := by
    rw [show (4 : ℝ) = 2 ^ (2 : ℝ) by norm_num, ← Real.rpow_mul (by norm_num),
      ← Real.rpow_natCast, ← Real.rpow_mul (by norm_num)]; norm_num
  rw [e]; exact this

/-- A certified root bound, at any point above the grid value `S/N`. -/
lemma okRoot_sound {S r : ℕ} (h : okRoot S r = true) {s : ℝ} (hs : (S : ℝ) ≤ certN * s) :
    (r : ℝ) / 2 ^ certK ≤ s ^ ((2 : ℝ) / 5) := by
  have hN : (0 : ℝ) < certN := by norm_num [certN]
  have hs0 : 0 ≤ s := by
    by_contra hneg; push_neg at hneg
    have : (certN : ℝ) * s < 0 := mul_neg_of_pos_of_neg hN hneg
    linarith [Nat.cast_nonneg (α := ℝ) S]
  have hNat : r ^ 5 * certN ^ 2 ≤ S ^ 2 * 2 ^ (5 * certK) := by simpa [okRoot] using h
  have hR : (r : ℝ) ^ 5 * (certN : ℝ) ^ 2 ≤ (S : ℝ) ^ 2 * 2 ^ (5 * certK) := by exact_mod_cast hNat
  have h5 : ((r : ℝ) / 2 ^ certK) ^ 5 ≤ s ^ 2 := by
    have hSN : ((S : ℝ) / certN) ^ 2 ≤ s ^ 2 :=
      pow_le_pow_left₀ (by positivity) (by rw [div_le_iff₀ hN]; linarith) 2
    refine le_trans ?_ hSN
    rw [div_pow, div_pow, div_le_div_iff₀ (by positivity) (by positivity), ← pow_mul,
      mul_comm certK 5]
    exact hR
  have := root_le (n := 5) (by norm_num) (by positivity) h5
  rwa [← Real.rpow_natCast s 2, ← Real.rpow_mul hs0, show ((2 : ℕ) : ℝ) * ((5 : ℕ) : ℝ)⁻¹ = 2 / 5
    by norm_num] at this

lemma one_le_pair {Q r₁ r₂ C X₁ X₂ : ℝ} {K KQ : ℕ} (hQ : 0 ≤ Q) (hr₁ : 0 ≤ r₁) (hr₂ : 0 ≤ r₂)
    (hC : Q / 2 ^ KQ ≤ C) (h₁ : r₁ / 2 ^ K ≤ X₁) (h₂ : r₂ / 2 ^ K ≤ X₂)
    (h : (2 : ℝ) ^ (K + KQ) ≤ Q * (r₁ + r₂)) : 1 ≤ C * (X₁ + X₂) := by
  have e : Q / 2 ^ KQ * ((r₁ + r₂) / 2 ^ K) = Q * (r₁ + r₂) / 2 ^ (K + KQ) := by
    rw [pow_add]; field_simp
  have h1 : 1 ≤ Q / 2 ^ KQ * ((r₁ + r₂) / 2 ^ K) := by
    rw [e, le_div_iff₀ (by positivity), one_mul]; exact h
  calc (1 : ℝ) ≤ Q / 2 ^ KQ * ((r₁ + r₂) / 2 ^ K) := h1
    _ ≤ C * (X₁ + X₂) :=
      mul_le_mul hC (by rw [add_div]; linarith) (by positivity) ((by positivity : 0 ≤ Q / 2 ^ KQ).trans hC)

lemma one_le_single {Q r C X : ℝ} {K KQ : ℕ} (hQ : 0 ≤ Q) (hr : 0 ≤ r) (hC : Q / 2 ^ KQ ≤ C)
    (h₁ : r / 2 ^ K ≤ X) (h : (2 : ℝ) ^ (K + KQ) ≤ Q * r) : 1 ≤ C * X := by
  have := one_le_pair (r₂ := 0) (X₂ := 0) hQ hr le_rfl hC h₁ (by simp) (by simpa using h)
  simpa using this

lemma le_sub_min {u : ℕ} {x : ℝ} (hx : 0 ≤ x) (h : (certN : ℝ) - u ≤ certN * x) :
    (((certN - min certN u : ℕ)) : ℝ) ≤ certN * x := by
  rw [Nat.cast_sub (min_le_left _ _), Nat.cast_min]
  rcases le_total (certN : ℝ) u with hu | hu
  · rw [min_eq_left hu]; simp; positivity
  · rw [min_eq_right hu]; exact h

theorem check_sound : ∀ (t : BT) (l₁ l₂ l₃ u₁ u₂ u₃ : ℕ), check t l₁ l₂ l₃ u₁ u₂ u₃ = true →
    ∀ x₁ x₂ x₃ x₄ : ℝ, 0 ≤ x₁ → 0 ≤ x₂ → 0 ≤ x₃ → 0 ≤ x₄ → x₁ + x₂ + x₃ + x₄ = 1 →
      (l₁ : ℝ) ≤ certN * x₁ → certN * x₁ ≤ u₁ → (l₂ : ℝ) ≤ certN * x₂ → certN * x₂ ≤ u₂ →
      (l₃ : ℝ) ≤ certN * x₃ → certN * x₃ ≤ u₃ →
      1 ≤ Phi (2 / 5) (33 / 400) x₁ x₂ x₃ x₄ := by
  intro t
  induction t with
  | d =>
    intro l₁ l₂ l₃ u₁ u₂ u₃ h x₁ x₂ x₃ x₄ h₁ h₂ h₃ h₄ hs a₁ _ a₂ _ a₃ _
    simp only [check, decide_eq_true_eq] at h
    have : ((certN : ℕ) : ℝ) < l₁ + l₂ + l₃ := by exact_mod_cast h
    have hN : (certN : ℝ) = 65536 := by norm_num [certN]
    rw [hN] at this a₁ a₂ a₃
    linarith
  | s lo hi ihlo ihhi =>
    intro l₁ l₂ l₃ u₁ u₂ u₃ h x₁ x₂ x₃ x₄ h₁ h₂ h₃ h₄ hs a₁ b₁ a₂ b₂ a₃ b₃
    simp only [check] at h
    split_ifs at h
    · obtain ⟨hlo, hhi⟩ := Bool.and_eq_true _ _ ▸ h
      rcases le_total (certN * x₁) (((l₁ + u₁) / 2 : ℕ) : ℝ) with hm | hm
      · exact ihlo _ _ _ _ _ _ hlo x₁ x₂ x₃ x₄ h₁ h₂ h₃ h₄ hs a₁ hm a₂ b₂ a₃ b₃
      · exact ihhi _ _ _ _ _ _ hhi x₁ x₂ x₃ x₄ h₁ h₂ h₃ h₄ hs hm b₁ a₂ b₂ a₃ b₃
    · obtain ⟨hlo, hhi⟩ := Bool.and_eq_true _ _ ▸ h
      rcases le_total (certN * x₂) (((l₂ + u₂) / 2 : ℕ) : ℝ) with hm | hm
      · exact ihlo _ _ _ _ _ _ hlo x₁ x₂ x₃ x₄ h₁ h₂ h₃ h₄ hs a₁ b₁ a₂ hm a₃ b₃
      · exact ihhi _ _ _ _ _ _ hhi x₁ x₂ x₃ x₄ h₁ h₂ h₃ h₄ hs a₁ b₁ hm b₂ a₃ b₃
    · obtain ⟨hlo, hhi⟩ := Bool.and_eq_true _ _ ▸ h
      rcases le_total (certN * x₃) (((l₃ + u₃) / 2 : ℕ) : ℝ) with hm | hm
      · exact ihlo _ _ _ _ _ _ hlo x₁ x₂ x₃ x₄ h₁ h₂ h₃ h₄ hs a₁ b₁ a₂ b₂ a₃ hm
      · exact ihhi _ _ _ _ _ _ hhi x₁ x₂ x₃ x₄ h₁ h₂ h₃ h₄ hs a₁ b₁ a₂ b₂ hm b₃
  | a j r₁ r₂ =>
    intro l₁ l₂ l₃ u₁ u₂ u₃ h x₁ x₂ x₃ x₄ h₁ h₂ h₃ h₄ hs a₁ b₁ a₂ b₂ a₃ b₃
    have hN : (certN : ℝ) = 65536 := by norm_num [certN]
    -- lower bounds for x₄ and for the pair sums containing it
    have l4 : (((certN - min certN (u₁ + u₂ + u₃) : ℕ)) : ℝ) ≤ certN * x₄ :=
      le_sub_min h₄ (by rw [hN] at b₁ b₂ b₃ ⊢; push_cast; linarith)
    have l34 : (((certN - min certN (u₁ + u₂) : ℕ)) : ℝ) ≤ certN * (x₃ + x₄) :=
      le_sub_min (by positivity) (by rw [hN] at b₁ b₂ b₃ ⊢; push_cast; linarith)
    have l24 : (((certN - min certN (u₁ + u₃) : ℕ)) : ℝ) ≤ certN * (x₂ + x₄) :=
      le_sub_min (by positivity) (by rw [hN] at b₁ b₂ b₃ ⊢; push_cast; linarith)
    have l12 : ((l₁ + l₂ : ℕ) : ℝ) ≤ certN * (x₁ + x₂) := by push_cast; linarith
    have l13 : ((l₁ + l₃ : ℕ) : ℝ) ≤ certN * (x₁ + x₃) := by push_cast; linarith
    have Q2n : (0 : ℝ) ≤ certQ2 := Nat.cast_nonneg _
    have Q4n : (0 : ℝ) ≤ certQ4 := Nat.cast_nonneg _
    have castQ : ∀ {Q r : ℕ}, 2 ^ (certK + certKQ) ≤ Q * r →
        (2 : ℝ) ^ (certK + certKQ) ≤ (Q : ℝ) * r := fun h => by exact_mod_cast h
    simp only [check, okAccept] at h
    rcases j with _ | _ | _ | _ | _ | _ | j
    · simp only [Bool.and_eq_true, decide_eq_true_eq] at h
      obtain ⟨⟨k₁, k₂⟩, k₃⟩ := h
      have := one_le_pair Q4n (Nat.cast_nonneg r₁) (Nat.cast_nonneg r₂) Q4_le
        (okRoot_sound k₁ a₁) (okRoot_sound k₂ l4) (by exact_mod_cast castQ k₃)
      exact this.trans (by simp [Phi])
    · simp only [Bool.and_eq_true, decide_eq_true_eq] at h
      obtain ⟨⟨k₁, k₂⟩, k₃⟩ := h
      have := one_le_pair Q4n (Nat.cast_nonneg r₁) (Nat.cast_nonneg r₂) Q4_le
        (okRoot_sound k₁ a₂) (okRoot_sound k₂ a₃) (by exact_mod_cast castQ k₃)
      exact this.trans (by simp [Phi])
    · simp only [Bool.and_eq_true, decide_eq_true_eq] at h
      have := one_le_single Q2n (Nat.cast_nonneg r₁) Q2_le (okRoot_sound h.1 l12)
        (by exact_mod_cast castQ h.2)
      exact this.trans (by simp [Phi])
    · simp only [Bool.and_eq_true, decide_eq_true_eq] at h
      have := one_le_single Q2n (Nat.cast_nonneg r₁) Q2_le (okRoot_sound h.1 l34)
        (by exact_mod_cast castQ h.2)
      exact this.trans (by simp [Phi])
    · simp only [Bool.and_eq_true, decide_eq_true_eq] at h
      have := one_le_single Q2n (Nat.cast_nonneg r₁) Q2_le (okRoot_sound h.1 l13)
        (by exact_mod_cast castQ h.2)
      exact this.trans (by simp [Phi])
    · simp only [Bool.and_eq_true, decide_eq_true_eq] at h
      have := one_le_single Q2n (Nat.cast_nonneg r₁) Q2_le (okRoot_sound h.1 l24)
        (by exact_mod_cast castQ h.2)
      exact this.trans (by simp [Phi])
    · simp at h

/-- **Lemma 5.1.** -/
theorem certOne : CertOne (2 / 5) (33 / 400) := by
  intro x₁ x₂ x₃ x₄ h₁ h₂ h₃ h₄ hs
  refine check_sound certTree 0 0 0 certN certN certN certTree_ok x₁ x₂ x₃ x₄ h₁ h₂ h₃ h₄ hs
    ?_ ?_ ?_ ?_ ?_ ?_ <;> norm_num [certN] <;> nlinarith

/-- **`M(n) ≥ n^0.235`**, with every step checked. -/
theorem M_lower_235 (m : ℕ) : (2 : ℝ) ^ ((m : ℝ) * (47 / 200)) ≤ M m := by
  have := M_lower_of_certOne (by norm_num) (by norm_num) certOne m
  convert this using 3; norm_num

