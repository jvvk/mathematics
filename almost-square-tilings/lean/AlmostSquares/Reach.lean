def reach57OK (e : Reach) : Bool :=
  if e.flip then rectOK 55 57 (rect57.map Tile.swap) 1 (tab e.u) (tab e.v) e.n
  else rectOK 57 55 rect57 1 (tab e.u) (tab e.v) e.n

/-- Every entry is a valid tiling of `R_n` by the inflated rectangle. -/
theorem reach57_ok : reach57.all reach57OK = true := by decide +kernel

theorem reach57OK_sound {e : Reach} (h : reach57OK e = true) :
    ∃ ts, Admissible e.n ts := by
  unfold reach57OK at h
  split at h
  · exact ⟨_, rectOK_sound h⟩
  · exact ⟨_, rectOK_sound h⟩

/-- The single 57 × 55 rectangle gives tilings for 67 of the 151 values left by the classes. -/
