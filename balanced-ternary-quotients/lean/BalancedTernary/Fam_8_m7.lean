/-- **Theorem.** 8·3^k - 7 ∉ B/B for every k ≥ 7. -/
theorem not_BB_8_m7 (k : Nat) (hk0 : 7 ≤ k) :
    ¬ ∃ m N : Int, 0 < m ∧ ZF m ∧ 0 < N ∧ ZF N ∧ N = (8 * 3 ^ k + (-7)) * m := by
  rcases (show k = 7 ∨ k = 8 ∨ k = 9 ∨ k = 10 ∨ k = 11 ∨ k = 12 ∨ k = 13 ∨ 14 ≤ k by omega) with rfl | rfl | rfl | rfl | rfl | rfl | rfl | hk
  · exact not_BB_8_m7_k7
  · exact not_BB_8_m7_k8
  · exact not_BB_8_m7_k9
  · exact not_BB_8_m7_k10
  · exact not_BB_8_m7_k11
  · exact not_BB_8_m7_k12
  · exact not_BB_8_m7_k13
  · rcases Nat.mod_two_eq_zero_or_one k with h | h
    · exact F8_m7_e.main k hk h
    · exact F8_m7_o.main k hk h

end Tern
