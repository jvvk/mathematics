/-- **Theorem.** 5·3^k - 4 ∉ B/B for every k ≥ 6 with k ≡ 2 (mod 4). -/
theorem not_BB_5_m4_4r2 (k : Nat) (hk0 : 6 ≤ k) (hkr : k % 4 = 2) :
