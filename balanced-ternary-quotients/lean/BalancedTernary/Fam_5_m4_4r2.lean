theorem F5_m4_4r2.main (k : Nat) (hk : 14 ≤ k) (hpar : k % 4 = 2) :
    ¬ ∃ m N : Int, 0 < m ∧ ZF m ∧ 0 < N ∧ ZF N ∧ N = (5 * 3 ^ k + (-4)) * m :=
  not_BB_of_inv _ (F5_m4_4r2 k) .z
    (fun _ _ _ _ hr hd hc hv => F5_m4_4r2.step hk hpar hr hd hc hv)
    (fun _ hr => F5_m4_4r2.bound hk hr)
