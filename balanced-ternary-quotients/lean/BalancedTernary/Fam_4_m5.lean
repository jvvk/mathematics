theorem F4_m5_o.step_s10 {k : Nat} (hk : 14 ≤ k) (hpar : k % 2 = 1) {r r' d c : Int}
    (hr : r = -(2 * 3 ^ (k - 1) + 2))
    (hd : d = 1 ∨ d = -1) (hc : c = 1 ∨ c = -1)
    (hv : r + (4 * 3 ^ k + (-5)) * d = 3 * r' + c) : F4_m5_o k r' := by
  have := p3 k (k - 1) (by omega)
  have := p3 (k - 1) (k - 2) (by omega)
  have := p3 (k - 2) (k - 3) (by omega)
  have := p3 (k - 3) (k - 4) (by omega)
  have := p3 (k - 4) (k - 5) (by omega)
  have := p3 (k - 5) (k - 6) (by omega)
  have := p3 (k - 6) (k - 7) (by omega)
  have := p3 (k - 7) (k - 8) (by omega)
  have := p3 (k - 8) (k - 9) (by omega)
  have := p3 (k - 9) (k - 10) (by omega)
  have := pow3_pos (k - 10)
  rcases hd with rfl | rfl <;> rcases hc with rfl | rfl
  · omega
  · exact (.c1 (k - 2) r' (by omega) (by omega) (by omega))
  · omega
  · omega

theorem F4_m5_o.bd_s10 {k : Nat} (hk : 14 ≤ k) {r : Int} (hr : r = -(2 * 3 ^ (k - 1) + 2)) : 2 - (4 * 3 ^ k + (-5)) ≤ r := by
  have := p3 k (k - 1) (by omega)
  have := p3 (k - 1) (k - 2) (by omega)
  have := p3 (k - 2) (k - 3) (by omega)
  have := p3 (k - 3) (k - 4) (by omega)
  have := p3 (k - 4) (k - 5) (by omega)
  have := p3 (k - 5) (k - 6) (by omega)
