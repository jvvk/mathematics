theorem F4_m5_o.step {k : Nat} (hk : 14 ≤ k) (hpar : k % 2 = 1) {r r' d c : Int}
    (hr : F4_m5_o k r) (hd : d = 1 ∨ d = -1) (hc : c = 1 ∨ c = -1)
    (hv : r + (4 * 3 ^ k + (-5)) * d = 3 * r' + c) : F4_m5_o k r' := by
  cases hr with
  | z => exact F4_m5_o.step_z hk hpar rfl hd hc hv
  | c1 i r h1 h2 hr => exact F4_m5_o.step_c1 hk hpar h1 h2 hr hd hc hv
  | c2 i r h1 h2 hr => exact F4_m5_o.step_c2 hk hpar h1 h2 hr hd hc hv
  | c3 i r h1 h2 hr => exact F4_m5_o.step_c3 hk hpar h1 h2 hr hd hc hv
  | s4 r hr => exact F4_m5_o.step_s4 hk hpar hr hd hc hv
  | s5 r hr => exact F4_m5_o.step_s5 hk hpar hr hd hc hv
  | c6 i r h1 h2 hr => exact F4_m5_o.step_c6 hk hpar h1 h2 hr hd hc hv
  | c7 i r h1 h2 hr => exact F4_m5_o.step_c7 hk hpar h1 h2 hr hd hc hv
  | c8 i r h1 h2 hr => exact F4_m5_o.step_c8 hk hpar h1 h2 hr hd hc hv
  | s9 r hr => exact F4_m5_o.step_s9 hk hpar hr hd hc hv
  | s10 r hr => exact F4_m5_o.step_s10 hk hpar hr hd hc hv

theorem F4_m5_o.bound {k : Nat} (hk : 14 ≤ k) {r : Int} (hr : F4_m5_o k r) : 2 - (4 * 3 ^ k + (-5)) ≤ r := by
  cases hr with
  | z => have := pow3_ge k 1 3 (by decide) (by omega); omega
  | c1 i r h1 h2 hr => exact F4_m5_o.bd_c1 hk h1 h2 hr
  | c2 i r h1 h2 hr => exact F4_m5_o.bd_c2 hk h1 h2 hr
  | c3 i r h1 h2 hr => exact F4_m5_o.bd_c3 hk h1 h2 hr
  | s4 r hr => exact F4_m5_o.bd_s4 hk hr
  | s5 r hr => exact F4_m5_o.bd_s5 hk hr
  | c6 i r h1 h2 hr => exact F4_m5_o.bd_c6 hk h1 h2 hr
  | c7 i r h1 h2 hr => exact F4_m5_o.bd_c7 hk h1 h2 hr
  | c8 i r h1 h2 hr => exact F4_m5_o.bd_c8 hk h1 h2 hr
  | s9 r hr => exact F4_m5_o.bd_s9 hk hr
  | s10 r hr => exact F4_m5_o.bd_s10 hk hr

theorem F4_m5_o.nz {k : Nat} (hk : 14 ≤ k) {r : Int} (hr : F4_m5_o k r) (hpos : 0 < r) : ¬ ZF r := by
  cases hr with
  | z => omega
  | c1 i r h1 h2 hr => exact F4_m5_o.nz_c1 hk h1 h2 hr hpos
  | c2 i r h1 h2 hr => exact F4_m5_o.nz_c2 hk h1 h2 hr hpos
  | c3 i r h1 h2 hr => exact F4_m5_o.nz_c3 hk h1 h2 hr hpos
  | s4 r hr => exact F4_m5_o.nz_s4 hk hr hpos
  | s5 r hr => exact F4_m5_o.nz_s5 hk hr hpos
  | c6 i r h1 h2 hr => exact F4_m5_o.nz_c6 hk h1 h2 hr hpos
  | c7 i r h1 h2 hr => exact F4_m5_o.nz_c7 hk h1 h2 hr hpos
  | c8 i r h1 h2 hr => exact F4_m5_o.nz_c8 hk h1 h2 hr hpos
  | s9 r hr => exact F4_m5_o.nz_s9 hk hr hpos
  | s10 r hr => exact F4_m5_o.nz_s10 hk hr hpos

theorem F4_m5_o.main (k : Nat) (hk : 14 ≤ k) (hpar : k % 2 = 1) :
    ¬ ∃ m N : Int, 0 < m ∧ ZF m ∧ 0 < N ∧ ZF N ∧ N = (4 * 3 ^ k + (-5)) * m :=
  not_BB_of_inv _ (F4_m5_o k) .z
    (fun _ _ _ _ hr hd hc hv => F4_m5_o.step hk hpar hr hd hc hv)
    (fun _ hr => F4_m5_o.bound hk hr)
    (fun _ _ _ hr hc hv hpos => F4_m5_o.nz hk (F4_m5_o.step hk hpar hr (.inl rfl) hc (by omega)) hpos)

