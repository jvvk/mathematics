/-- **Theorem.** 10·3^k - 11 ∉ B/B for every k ≥ 6 with k ≡ 2 (mod 4). -/
theorem not_BB_10_m11_4r2 (k : Nat) (hk0 : 6 ≤ k) (hkr : k % 4 = 2) :
    ¬ ∃ m N : Int, 0 < m ∧ ZF m ∧ 0 < N ∧ ZF N ∧ N = (10 * 3 ^ k + (-11)) * m := by
