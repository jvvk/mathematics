theorem F10_m11_4r2.main (k : Nat) (hk : 14 ≤ k) (hpar : k % 4 = 2) :
    ¬ ∃ m N : Int, 0 < m ∧ ZF m ∧ 0 < N ∧ ZF N ∧ N = (10 * 3 ^ k + (-11)) * m :=
  not_BB_of_inv _ (F10_m11_4r2 k) .z
    (fun _ _ _ _ hr hd hc hv => F10_m11_4r2.step hk hpar hr hd hc hv)
    (fun _ hr => F10_m11_4r2.bound hk hr)
    (fun _ _ _ hr hc hv hpos => F10_m11_4r2.nz hk (F10_m11_4r2.step hk hpar hr (.inl rfl) hc (by omega)) hpos)

