/-- **Theorem.** 5·3^k + 4 ∉ B/B for every k ≥ 8 with k ≡ 0 (mod 4). -/
theorem not_BB_5_p4_4r0 (k : Nat) (hk0 : 8 ≤ k) (hkr : k % 4 = 0) :
    ¬ ∃ m N : Int, 0 < m ∧ ZF m ∧ 0 < N ∧ ZF N ∧ N = (5 * 3 ^ k + 4) * m := by
  rcases (show k = 8 ∨ k = 12 ∨ 14 ≤ k by omega) with rfl | rfl | hk
  · exact not_BB_5_p4_4r0_k8
  · exact not_BB_5_p4_4r0_k12
  · exact F5_p4_4r0.main k hk hkr

