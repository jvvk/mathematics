  | c18 i r h1 h2 h3 hr => exact F5_p4_4r0.nz_c18 hk h1 h2 h3 hr hpos
  | s19 r hr => exact F5_p4_4r0.nz_s19 hk hr hpos
  | s20 r hr => exact F5_p4_4r0.nz_s20 hk hr hpos

theorem F5_p4_4r0.main (k : Nat) (hk : 14 ≤ k) (hpar : k % 4 = 0) :
    ¬ ∃ m N : Int, 0 < m ∧ ZF m ∧ 0 < N ∧ ZF N ∧ N = (5 * 3 ^ k + 4) * m :=
  not_BB_of_inv _ (F5_p4_4r0 k) .z
    (fun _ _ _ _ hr hd hc hv => F5_p4_4r0.step hk hpar hr hd hc hv)
    (fun _ hr => F5_p4_4r0.bound hk hr)
    (fun _ _ _ hr hc hv hpos => F5_p4_4r0.nz hk (F5_p4_4r0.step hk hpar hr (.inl rfl) hc (by omega)) hpos)

